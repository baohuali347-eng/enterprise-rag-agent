{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit 界面",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "kb_agent/ui.py", "--server.headless", "true"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "命令行问答",
      "type": "debugpy",
      "request": "launch",
      "module": "kb_agent.cli",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}
